package server

import (
	"bytes"
	"context"
	"encoding/json"
	"net/http"
	"net/http/httptest"
	"reflect"
	"strings"
	"sync/atomic"
	"testing"
	"time"
)

type modelListTestResponse struct {
	OK     bool     `json:"ok"`
	Models []string `json:"models"`
	Error  string   `json:"error"`
}

func modelListRequest(t *testing.T, ctx context.Context, input map[string]any) modelListTestResponse {
	t.Helper()
	body, err := json.Marshal(input)
	if err != nil {
		t.Fatal(err)
	}
	r := httptest.NewRequest(http.MethodPost, "/api/llm/models", bytes.NewReader(body)).WithContext(ctx)
	w := httptest.NewRecorder()
	(&Server{}).pgListModels(w, r)
	if w.Code != http.StatusOK {
		t.Fatalf("status=%d body=%s", w.Code, w.Body)
	}
	var response modelListTestResponse
	if err := json.Unmarshal(w.Body.Bytes(), &response); err != nil {
		t.Fatal(err)
	}
	return response
}

func TestModelListEndpoints(t *testing.T) {
	for _, tc := range []struct {
		name, provider, basePath, endpoint, auth string
	}{
		{"openai version", "openai", "/v1", "/v1/models", "bearer"},
		{"openai root", "openai", "", "/models", "bearer"},
		{"openai root fallback", "openai", "", "/v1/models", "bearer"},
		{"openai custom prefix", "openai", "/gateway/api", "/gateway/api/v1/models", "bearer"},
		{"openai full endpoint", "openai", "/v1/chat/completions/", "/v1/models", "bearer"},
		{"responses prefix", "openai-responses", "/v1/", "/v1/models", "bearer"},
		{"responses full endpoint", "openai-responses", "/v1/responses", "/v1/models", "bearer"},
		{"models full endpoint", "openai", "/v1/models", "/v1/models", "bearer"},
		{"anthropic root", "anthropic", "", "/v1/models", "anthropic"},
		{"anthropic version", "anthropic", "/v1/", "/v1/models", "anthropic"},
		{"anthropic full endpoint", "anthropic", "/v1/messages", "/v1/models", "anthropic"},
		{"anthropic models endpoint", "anthropic", "/v1/models", "/v1/models", "anthropic"},
		{"anthropic prefixed endpoint", "anthropic", "/anthropic/v1/messages", "/anthropic/v1/models", "anthropic"},
		{"anthropic gateway fallback", "anthropic", "/anthropic", "/models", "bearer"},
		{"anthropic versioned gateway fallback", "anthropic", "/anthropic/v1", "/v1/models", "bearer"},
		{"anthropic unprefixed gateway fallback", "anthropic", "/v1", "/v1/models", "bearer"},
		{"public model list", "openai", "/v1", "/v1/models", "none"},
	} {
		t.Run(tc.name, func(t *testing.T) {
			var paths []string
			upstream := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
				paths = append(paths, r.URL.Path)
				if r.Method != http.MethodGet || r.URL.Query().Get("region") != "test" {
					t.Errorf("method/query lost: %s %s", r.Method, r.URL)
				}
				correctAuth := false
				switch tc.auth {
				case "bearer":
					correctAuth = r.Header.Get("Authorization") == "Bearer test-key" && r.Header.Get("x-api-key") == ""
				case "anthropic":
					correctAuth = r.Header.Get("x-api-key") == "test-key" && r.Header.Get("anthropic-version") == "2023-06-01"
				case "none":
					correctAuth = r.Header.Get("Authorization") == "" && r.Header.Get("x-api-key") == ""
				}
				if r.URL.Path != tc.endpoint || !correctAuth {
					http.Error(w, "try another endpoint", http.StatusNotFound)
					return
				}
				_, _ = w.Write([]byte(`{"data":[{"id":" model-b "},{"id":"model-a"},{"id":"model-a"},{"id":""},{"id":"  "}]}`))
			}))
			defer upstream.Close()
			key := " test-key "
			if tc.auth == "none" {
				key = ""
			}
			response := modelListRequest(t, context.Background(), map[string]any{
				"provider": tc.provider, "base_url": " " + upstream.URL + tc.basePath + "?region=test#ignored ", "api_key": key,
			})
			if !response.OK || !reflect.DeepEqual(response.Models, []string{"model-b", "model-a"}) {
				t.Fatalf("response=%+v paths=%v", response, paths)
			}
			for _, p := range paths {
				if strings.Contains(p, "/v1/v1") || strings.Contains(p, "/models/models") {
					t.Fatalf("duplicated path segment: %s", p)
				}
			}
		})
	}
}

func TestModelListErrorsAndEmptyResults(t *testing.T) {
	for _, tc := range []struct {
		name, body string
		status     int
		ok         bool
		errorText  string
	}{
		{"empty", `{"data":[]}`, 200, true, ""},
		{"unauthorized", `{"error":"invalid key"}`, 401, false, "401"},
		{"invalid json", `not json`, 200, false, "解析响应失败"},
		{"invalid schema", `{"data":"not an array"}`, 200, false, "解析响应失败"},
	} {
		t.Run(tc.name, func(t *testing.T) {
			upstream := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
				w.WriteHeader(tc.status)
				_, _ = w.Write([]byte(tc.body))
			}))
			defer upstream.Close()
			response := modelListRequest(t, context.Background(), map[string]any{
				"provider": "openai", "base_url": upstream.URL + "/v1", "api_key": "key",
			})
			if response.OK != tc.ok || (tc.errorText != "" && !strings.Contains(response.Error, tc.errorText)) {
				t.Fatalf("response=%+v", response)
			}
			if tc.ok && (response.Models == nil || len(response.Models) != 0) {
				t.Fatalf("empty result should be []: %+v", response)
			}
		})
	}
}

func TestModelListValidation(t *testing.T) {
	for _, base := range []string{"ftp://example.com", "localhost:8000", "https://", "https://user:pass@example.com", "http://%"} {
		response := modelListRequest(t, context.Background(), map[string]any{"base_url": base})
		if response.OK || !strings.Contains(response.Error, "Base URL") {
			t.Fatalf("base=%s response=%+v", base, response)
		}
	}
	response := modelListRequest(t, context.Background(), map[string]any{"base_url": "http://127.0.0.1", "proxy": "not-a-proxy"})
	if response.OK || !strings.Contains(response.Error, "代理") {
		t.Fatalf("invalid proxy: %+v", response)
	}
}

func TestModelListCancellationStopsFallback(t *testing.T) {
	var calls atomic.Int32
	upstream := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		calls.Add(1)
		<-r.Context().Done()
	}))
	defer upstream.Close()
	ctx, cancel := context.WithTimeout(context.Background(), 100*time.Millisecond)
	defer cancel()
	response := modelListRequest(t, ctx, map[string]any{"provider": "anthropic", "base_url": upstream.URL, "api_key": "key"})
	if response.OK || calls.Load() != 1 {
		t.Fatalf("cancelled request retried: response=%+v calls=%d", response, calls.Load())
	}
}

func TestModelListUsesConfiguredProxy(t *testing.T) {
	proxy := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		if r.URL.Host != "provider.invalid" || r.URL.Path != "/v1/models" || r.Header.Get("Authorization") != "Bearer key" {
			t.Errorf("incorrect proxy request: %s", r.URL)
		}
		_, _ = w.Write([]byte(`{"data":[{"id":"proxied-model"}]}`))
	}))
	defer proxy.Close()
	response := modelListRequest(t, context.Background(), map[string]any{
		"provider": "openai", "base_url": "http://provider.invalid/v1", "api_key": "key", "proxy": proxy.URL,
	})
	if !response.OK || !reflect.DeepEqual(response.Models, []string{"proxied-model"}) {
		t.Fatalf("response=%+v", response)
	}
}

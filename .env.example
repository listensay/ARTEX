# Docker 部署配置（复制为 .env）
# 构建时下载依赖使用的 HTTP 代理（可留空；容器访问宿主机需用 host.docker.internal）
ARTEX_BUILD_PROXY=

# 可选 Clash VPN-only 部署：先运行 deploy/vpn/configure.py 并阅读 README-FORK.md。
# 启用后取消下行注释，后续普通 docker compose 命令也保留 VPN 覆盖。
# COMPOSE_FILE=docker-compose.yml:docker-compose.vpn.yml
# 可选内部模型中转，仅填明确的 host:port；不得把宿主任意代理端口作为测试直连出口。
# ARTEX_VPN_INTERNAL_SERVICES=host.docker.internal:3425
# VPN 覆盖自动设置 ARTEX_VPN_LLM_PROXY=http://127.0.0.1:7890，优先于旧模型代理且不改已保存配置。
# 已信任的 PEM 根证书可放在 .vpn/ca/*.crt，供网关验证调试／企业代理 TLS；不要关闭验签。

# 门控在所有监听地址默认开启；仅隔离开发环境可显式关闭。
ARTEX_GATE=on
ARTEX_GATE_PATH=
ARTEX_GATE_TOKEN=
ARTEX_GATE_TTL_HOURS=168
# 空口令会独立随机生成到 .secrets/gate.token；不再使用入口路径作为口令。
ARTEX_HTTP_BIND=127.0.0.1
# 只信任实际反向代理的源 IP/CIDR；默认忽略所有 Forwarded 头。
ARTEX_TRUSTED_PROXIES=
# 额外允许的完整 Origin，以逗号分隔；默认仅同源。
ARTEX_ALLOWED_ORIGINS=
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# LLM（二选一或都填；也可留空到 UI 里配）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=

# 外部工具清单覆盖（留空使用镜像内置清单；以下路径均为容器内路径）
# 自定义清单需要自行挂载，也可放入已挂载的 /app/data 下。
ARTEX_TOOLS_MANIFEST=
ARTEX_SUO5_PATH=
ARTEX_CHISEL_PATH=
ARTEX_SUO5_PAYLOADS_DIR=

# 单次 LLM Stream/Complete 调用秒数，默认600；0关闭；重建应用后生效
ARTEX_LLM_CALL_TIMEOUT=600

# Fork managed intranet resources (listeners remain on loopback)
ARTEX_CALLBACK_ADDR=
ARTEX_TUNNEL_PORT_RANGE=20000-20099
ARTEX_TASK_PROXY=1
ARTEX_TASK_PROXY_PORT_RANGE=21100-21199

# ScopeSentry 随 docker compose up -d artex 自动启动；密码/API Key 自动保存在 .secrets/scopesentry。
# 默认仅回环发布管理界面，容器内 MCP 地址不受宿主端口影响。
SCOPESENTRY_PORT=8082
SCOPESENTRY_NODE_NAME=artex-local-1
# 留空使用 docker-compose.yml 固定的官方镜像摘要；升级前检查 API/节点兼容性。
SCOPESENTRY_IMAGE=
SCOPESENTRY_SCAN_IMAGE=

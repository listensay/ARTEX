# Docker 部署配置（复制为 .env）
# 构建时下载依赖使用的 HTTP 代理（可留空；容器访问宿主机需用 host.docker.internal）
ARTEX_BUILD_PROXY=
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# LLM（二选一或都填；也可留空到 UI 里配）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=
